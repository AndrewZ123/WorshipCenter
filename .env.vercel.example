# WorshipCenter - Vercel Deployment Environment Variables Template
# Copy this to Vercel project settings and fill in your actual values

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
# ============================================================================

# Public keys (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (server-side only, full access to database)
# Get this from: https://supabase.com/dashboard → Your Project → Settings → API → service_role
# NEVER commit this value or expose it to client code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys (switch to Live mode for production)
# ============================================================================

# API Keys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Price IDs (Create these in Stripe Dashboard → Products)
# Monthly: Create product with $29/month pricing
# Yearly: Create product with $290/year pricing
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id_here
STRIPE_YEARLY_PRICE_ID=price_your_yearly_price_id_here

# Get this from: https://dashboard.stripe.com/webhooks
# After creating the webhook endpoint, click on it to get the signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# The URL where your app is deployed
NEXT_PUBLIC_APP_URL=https://app.worshipcenter.app

# ============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# ============================================================================
# Get these from: https://resend.com
# Email service for welcome emails, team invitations, and service reminders
# ============================================================================

# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The sender email address (must be a verified domain in Resend)
# Format: "Name <email>" - the name is what recipients see as the sender
# Example: "WorshipCenter <hello@worshipcenter.app>"
EMAIL_FROM=WorshipCenter <hello@worshipcenter.app>

# ============================================================================
# PUSH NOTIFICATIONS (OPTIONAL)
# ============================================================================
# Get these from: https://console.firebase.google.com → Your Project → Project Settings → Cloud Messaging
# Push notifications require a Firebase project with Cloud Messaging enabled.
# For iOS: Upload your APNs key to Firebase Console under Cloud Messaging settings.
# ============================================================================

# Firebase Cloud Messaging Server Key (Legacy) for sending push notifications
# This key allows the server to send push notifications to iOS and Android devices
FCM_SERVER_KEY=AAAA...

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Node environment (Vercel sets this automatically)
NODE_ENV=production

# Enable static export for Capacitor builds (DO NOT set this in Vercel!)
# STATIC_EXPORT=true

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. NEVER commit actual values to git - use this template only
# 2. Add these to Vercel project settings under Environment Variables
# 3. Vercel will automatically redeploy when you update environment variables
# 4. Variables starting with NEXT_PUBLIC_ are exposed to the browser
# 5. Other variables are server-side only (more secure)
# 6. Use test mode keys for development/staging
# 7. Use live mode keys for production
#
# ============================================================================