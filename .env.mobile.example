# ──────────────────────────────────────────────────────────────
# Mobile (Capacitor) Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy to .env.local and fill in real values.
# These are read at BUILD TIME and baked into the static export.
# The mobile app runs as a static bundle in a WebView — there is no
# server-side env, so all values must be NEXT_PUBLIC_*.
#
# The WEB_BASE_URL is critical: when running inside a Capacitor WebView
# (origin: capacitor://worshipcenter.app or https://localhost), all
# /api/* calls are rewritten to point at your deployed Next.js server.
# See src/lib/api-base.ts → apiUrl().

# Your deployed Next.js app URL (staging or production)
# Mobile API calls go here instead of relative /api/* paths
NEXT_PUBLIC_WEB_BASE_URL=https://worshipcenter-app.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (publishable key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_key

# App URL for deep-link redirect configuration
NEXT_PUBLIC_APP_URL=https://worshipcenter.app

# App Store / Play Store bundle IDs (for OAuth/deep-link redirects)
# Must match capacitor.config.json → appId
NEXT_PUBLIC_MOBILE_APP_ID=com.worshipcenter.app